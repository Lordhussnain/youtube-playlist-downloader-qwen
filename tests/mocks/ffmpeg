#!/usr/bin/env bun
// tests/mocks/ffmpeg — a fake ffmpeg for offline integration tests.
//
// The engine only uses ffmpeg to transcode (mp3) and remux (mp4), so the mock
// just produces the output file it was asked to write. `-version` is answered
// for the dependency probe.

const argv = process.argv.slice(2);

if (argv[0] === "-version") {
  console.log("ffmpeg version 7.0.2-mock https://example.invalid/ffmpeg");
  process.exit(0);
}

// The output path is the last argument that does not start with "-".
const out = [...argv].reverse().find((a) => !a.startsWith("-") && a.length > 0);
if (out) {
  await Bun.write(out, "fake-ffmpeg-output");
  console.error("ffmpeg mock: wrote " + out);
  process.exit(0);
}
console.error("ffmpeg mock: no output path found");
process.exit(1);
