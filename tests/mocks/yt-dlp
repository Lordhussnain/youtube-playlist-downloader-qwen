#!/usr/bin/env bun
// tests/mocks/yt-dlp — a fake yt-dlp for offline integration tests.
//
// Speaks just enough of yt-dlp's CLI surface for the engine to run its whole
// pipeline against it:
//   • --version
//   • --flat-playlist --print "%(playlist_title)s|||%(id)s|||%(title)s|||%(duration)s"
//   • download mode (-o TEMPLATE …): writes a fake media file, prints
//     PROGRESS lines and the final path
//   • --skip-download (metadata): writes sidecar files
//   • -U (self-update)
//
// Failure injection via environment variables:
//   FAKE_FAIL_TIMES=2        fail the first N download attempts (leaves a .part)
//   FAKE_FAIL_MODE=transient|permanent|corrupt   what the failure looks like
//   FAKE_HANG=1             hang forever (watchdog test)
//   FAKE_DELAY_MS=250       per-attempt delay (progress parsing)

const argv = process.argv.slice(2);

function flag(name: string): boolean {
  return argv.includes(name);
}
function flagValue(name: string): string | null {
  const i = argv.indexOf(name);
  return i >= 0 && i + 1 < argv.length ? argv[i + 1] : null;
}
const num = (name: string, dflt: number): number => {
  const v = process.env[name];
  const n = v ? parseInt(v, 10) : NaN;
  return Number.isFinite(n) ? n : dflt;
};

if (flag("--version")) {
  console.log("2026.01.01-mock");
  process.exit(0);
}

if (flag("-U")) {
  console.log("yt-dlp is up to date (mock)");
  process.exit(0);
}

// --- metadata-only pass (sidecar fetching) -----------------------------------
if (flag("--skip-download")) {
  const outTemplate = flagValue("-o") || "./video.%(ext)s";
  const base = outTemplate.replace(/\.%\(ext\)s$/, "");
  const written: string[] = [];
  const write = (suffix: string, content: string) => {
    Bun.write(`${base}${suffix}`, content);
    written.push(`${base}${suffix}`);
  };
  if (flag("--write-subs")) write(".en.vtt", "WEBVTT\n\n00:00.000 --> 00:01.000\nmock subtitle\n");
  if (flag("--write-thumbnail")) write(".jpg", "fake-jpeg-bytes");
  if (flag("--write-description")) write(".description", "mock description");
  if (flag("--write-info-json")) write(".info.json", JSON.stringify({ id: "mock", title: "Mock Video" }));
  for (const w of written) console.log(w);
  process.exit(0);
}

// --- flat playlist listing ----------------------------------------------------
if (flag("--flat-playlist")) {
  const lines = [
    "Mock Playlist|||mockvid001|||First Mock Video|||125",
    "Mock Playlist|||mockvid002|||Second Mock Video|||640",
    "Mock Playlist|||mockvid003|||Third Mock Video (long)|||7320",
  ];
  console.log(lines.join("\n"));
  process.exit(0);
}

// --- download -----------------------------------------------------------------
const outTemplate = flagValue("-o") || "./video.%(ext)s";
const base = outTemplate.replace(/\.%\(ext\)s$/, "");
const finalPath = `${base}.mp4`;
const partPath = `${base}.f137.mp4.part`;

const failTimes = num("FAKE_FAIL_TIMES", 0);
const failMode = process.env.FAKE_FAIL_MODE || "transient";
const delayMs = num("FAKE_DELAY_MS", 60);
const counterFile = `${base}.attempts`;

// Count attempts across processes so a retry loop sees the same counter.
let attempts = 0;
try {
  attempts = parseInt(await Bun.file(counterFile).text(), 10) || 0;
} catch {}
attempts += 1;
await Bun.write(counterFile, String(attempts));

if (process.env.FAKE_HANG === "1") {
  // Simulate a wedged download: never exits, ignores the abort signal enough
  // for the watchdog to fire.
  await new Promise(() => {});
}

if (failTimes > 0 && attempts <= failTimes) {
  // Leave a partial file behind — exactly like a real interrupted download —
  // so the engine's resume path has something to continue from.
  await Bun.write(partPath, "x".repeat(4096));
  await Bun.sleep(delayMs);
  const msg =
    failMode === "permanent"
      ? "ERROR: [youtube] mockvid001: Video unavailable. This video is private"
      : failMode === "corrupt"
        ? "ERROR: unable to resume download, incomplete or corrupt data"
        : "ERROR: Unable to download webpage: Connection reset by peer (transient mock failure)";
  console.error(msg);
  process.exit(1);
}

// Progress output in the engine's PROGRESS format, then the final path.
console.log(`PROGRESS:10.0|1.0MiB|12|10485760|1048576`);
await Bun.sleep(delayMs);
console.log(`PROGRESS:55.5|2.5MiB|6|10485760|5820416`);
await Bun.sleep(delayMs);
console.log(`PROGRESS:100.0|2.5MiB|0|10485760|10485760`);

await Bun.write(finalPath, "fake-mp4-bytes");
// Clean up the bookkeeping file so reruns start fresh.
try {
  await Bun.file(counterFile).unlink();
} catch {}
console.log(finalPath);
process.exit(0);
